# Server Configuration
PORT=8000
HOST=0.0.0.0

# FIRDS Storage & Cache Configuration
# On Render free tier / Linux, /tmp/firds_cache uses ephemeral scratch storage.
FIRDS_CACHE_DIR=/tmp/firds_cache

# Regulatory Feeds
ESMA_SOLR_URL=https://registers.esma.europa.eu/solr/esma_registers_firds_files/select
ESMA_TIMEOUT_SECONDS=30

# Optional path to bundled / local DLTINS data directory
FIRDS_DATA_DIR=sample_data
